{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "tenants"],
  "properties": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "cluster"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1}
      }
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenantId", "displayName", "metricName", "window"],
        "properties": {
          "tenantId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "displayName": {"type": "string", "minLength": 1},
          "metricName": {"type": "string", "enum": ["http_requests_total", "request_duration_seconds_count"]},
          "window": {"type": "string", "enum": ["5m", "10m", "15m"]}
        }
      }
    }
  }
}
